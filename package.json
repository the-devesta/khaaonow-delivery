{
  "name": "khaaonow-delivery",
  "main": "expo-router/entry",
  "version": "1.0.11",
  "expo": {
    "autolinking": {
      "ios": {
        "exclude": [
          "expo-glass-effect",
          "expo-symbols"
        ]
      },
      "android": {
        "exclude": [
          "expo-glass-effect",
          "expo-symbols"
        ]
      }
    }
  },
  "scripts": {
    "postinstall": "node scripts/patch-expo-router-glass.js && node scripts/prebuild-expo-modules-jsi.js",
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "node scripts/prebuild-expo-modules-jsi.js && EXPO_DERIVED_DATA_PATH=/Volumes/External/Developer/DerivedData/khaaonow-delivery PATH=$PWD/scripts/xcodebuild-bin:$PATH expo run:ios",
    "ios:clean": "rm -rf /Volumes/External/Developer/DerivedData/khaaonow-delivery && pod install --project-directory=ios && node scripts/prebuild-expo-modules-jsi.js && EXPO_DERIVED_DATA_PATH=/Volumes/External/Developer/DerivedData/khaaonow-delivery PATH=$PWD/scripts/xcodebuild-bin:$PATH expo run:ios --no-build-cache",
    "web": "expo start --web",
    "lint": "expo lint",
    "security:check": "node scripts/security-check.js"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@react-native-async-storage/async-storage": "2.2.0",
    "axios": "^1.13.2",
    "expo": "~56.0.16",
    "expo-auth-session": "~56.0.15",
    "expo-blur": "~56.0.4",
    "expo-build-properties": "~56.0.23",
    "expo-clipboard": "~56.0.4",
    "expo-constants": "~56.0.18",
    "expo-crypto": "~56.0.4",
    "expo-device": "~56.0.4",
    "expo-font": "~56.0.7",
    "expo-glass-effect": "^56.0.4",
    "expo-haptics": "~56.0.3",
    "expo-image": "~56.0.11",
    "expo-image-picker": "~56.0.21",
    "expo-linear-gradient": "~56.0.4",
    "expo-linking": "~56.0.15",
    "expo-location": "~56.0.21",
    "expo-notifications": "~56.0.21",
    "expo-router": "~56.2.15",
    "expo-secure-store": "~56.0.4",
    "expo-splash-screen": "~56.0.13",
    "expo-status-bar": "~56.0.4",
    "expo-symbols": "~56.0.6",
    "expo-system-ui": "~56.0.5",
    "expo-task-manager": "~56.0.22",
    "expo-web-browser": "~56.0.5",
    "firebase": "^11.10.0",
    "formik": "^2.4.9",
    "i18next": "^26.3.6",
    "nativewind": "^4.2.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^17.0.11",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-maps": "1.27.2",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.8.3",
    "socket.io-client": "^4.8.3",
    "yup": "^1.7.1",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/runtime": "^7.28.4",
    "@types/react": "~19.2.14",
    "babel-plugin-react-compiler": "^1.0.0",
    "babel-preset-expo": "~56.0.0",
    "baseline-browser-mapping": "^2.11.1",
    "eas-cli": "^18.10.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~56.0.4",
    "tailwindcss": "^3.4.18",
    "typescript": "~6.0.3"
  },
  "private": true
}
